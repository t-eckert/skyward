# Only needed for a binary built WITHOUT the `usb` feature.
#
# With `cargo build --release --features usb` skyward drives the dongle itself
# and this unit should not be installed at all — two processes competing for
# one USB device is a guaranteed "usb_claim_interface error -6".
#
# No -f or -s flags: skyward speaks the rtl_tcp control protocol and sets the
# frequency, sample rate and gain itself over the socket.

[Unit]
Description=rtl_tcp IQ server for skyward
After=network-online.target
Before=skyward.service
# Do not give up after the default five attempts in ten seconds. A Pi that
# boots before its USB bus settles, or before NTP, would otherwise be
# permanently `failed` after a power cut — the exact scenario this is
# deployed into, and the one thing this unit most has to survive.
#
# This MUST live in [Unit], not [Service]. systemd accepts the file either way
# and silently ignores it in [Service], logging only
#   Unknown key 'StartLimitIntervalSec' in section [Service], ignoring
# at load time, so the protection reads as present in the file and is not.
# Verify with:  systemctl show <unit> -p StartLimitIntervalUSec   (want 0)
StartLimitIntervalSec=0

[Service]
Type=exec
User=skyward
SupplementaryGroups=plugdev
# Localhost only. skyward is the sole client, and an open IQ server on a LAN is
# an unauthenticated radio anyone can retune.
ExecStart=/usr/bin/rtl_tcp -a 127.0.0.1 -p 1234
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rtl_tcp

[Install]
WantedBy=multi-user.target
