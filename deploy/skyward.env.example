# /etc/skyward.env -- for a Pi published over Tailscale.
#
# Copy this to /etc/skyward.env BEFORE running deploy/install.sh. The installer
# writes its own default only when the file does not already exist, so putting
# this in place first means the receiver never has a window where it is bound
# to every interface.
#
# `skyward config` prints every value with where it came from. That is how you
# confirm an edit took effect on a machine you are not logged into.

# ---------------------------------------------------------------- network
# Loopback ONLY. tailscaled proxies to this from the tailnet, so there is no
# reason for the port to exist on the LAN.
#
# This matters more than it looks: PUT /api/v1/receiver is unauthenticated, and
# on 0.0.0.0 anything on the network can move the receiver's position. Behind
# `tailscale serve` the front door is authenticated by the tailnet and the
# transport is real TLS.
SKYWARD_BIND=127.0.0.1:8080

# ---------------------------------------------------------------- position
# Deliberately UNSET, and that is not an oversight.
#
# Set the position from the web interface instead. It persists to
# SKYWARD_STATION_FILE, survives restarts and binary upgrades, and the tracker
# adopts the new range gate without dropping anything it is currently tracking.
#
# Leaving these blank also keeps `doctor` quiet. A runtime position OVERRIDES
# this file, and when the two disagree `doctor` raises station.shadowed -- a
# useful warning that becomes pure noise on a receiver that legitimately moves.
# One source of truth, no warning, no restart to relocate.
#
#   SKYWARD_RECEIVER_LAT=
#   SKYWARD_RECEIVER_LON=
SKYWARD_RECEIVER_ALT_M=0

# ---------------------------------------------------------------- radio
# This binary drives the dongle directly; no rtl_tcp, no localhost socket
# carrying 4.8 MB/s. Requires a build with --features usb.
SKYWARD_SOURCE=usb
SKYWARD_SAMPLE_RATE_HZ=2400000
# Must be a step this tuner actually offers or startup fails and prints the
# real list. Maximum gain is often NOT optimal -- it lifts the noise floor too.
SKYWARD_GAIN_DB=49.6

# ---------------------------------------------------------------- storage
SKYWARD_DB_PATH=/var/lib/skyward/skyward.db
SKYWARD_STATION_FILE=/var/lib/skyward/skyward-station.toml
# Three days. The trade is SD-card writes against history you can look back
# through; 0 keeps everything and will eventually fill the card.
SKYWARD_RETENTION_HOURS=72

# ---------------------------------------------------------------- logging
# json so journald parses fields rather than lines.
SKYWARD_LOG_FORMAT=json
RUST_LOG=info
