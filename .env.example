# Copy to `.env` and fill in. `.env` is gitignored -- the receiver position is
# a home address and does not belong in a public repository.
#
# Precedence, lowest to highest:
#   defaults < skyward.toml < .env < environment < CLI flags < the station overlay
# `skyward config` and `skyward doctor` print every resolved value together with
# where it came from, so a setting that did not take effect is visible rather
# than mysterious. Full reference: docs/CONFIGURATION.md

# --- Receiver position -------------------------------------------------------
# Used for local CPR resolution, the range plausibility gate, and the range ring
# the map client draws.
#
# ACCURACY: three decimal places (~100 m) is far more than enough. Local CPR only
# needs the reference to fall in the same ~670 km zone as the aircraft, and the
# range gate works at 400 km. Round these deliberately -- precision buys nothing
# here and publishing your exact address costs something. (Centimetre accuracy
# would only matter for MLAT, which this project does not do.)
#
# There is no default, and there is deliberately no fallback to 0,0 -- that is
# in the Gulf of Guinea, and the range gate would then reject every aircraft on
# earth while looking exactly like poor reception.
#
# Leaving both blank is fine. The server starts, warns, and runs with the range
# gate and local CPR disabled; you can then set the position from the web
# interface without a restart. Note the precedence, though: a position set that
# way is persisted to SKYWARD_STATION_FILE and OVERRIDES these two from then on.
# `skyward doctor` reports it (station.shadowed) when they disagree, and
# `curl -X DELETE .../api/v1/receiver` reverts it.
#
# Both or neither. One without the other is a startup error.
SKYWARD_RECEIVER_LAT=45.412
SKYWARD_RECEIVER_LON=-75.679

# Antenna height above sea level, metres. Only used to estimate the theoretical
# radio horizon in `doctor`; a rough figure is fine.
SKYWARD_RECEIVER_ALT_M=90

# --- Radio -------------------------------------------------------------------
# file:PATH | tcp:HOST:PORT | usb[:INDEX]
#
# `usb` drives the dongle directly and needs a binary built with the `usb`
# cargo feature (`cargo build --release --features usb`, which needs librtlsdr).
# Without the feature it is a startup error naming both ways forward.
# `skyward devices` lists what is on the bus.
#
# `tcp:` needs rtl_tcp running separately. Never run both against one dongle.
SKYWARD_SOURCE=tcp:127.0.0.1:1234
SKYWARD_SAMPLE_RATE_HZ=2400000

# Must be one of the tuner's discrete gain values -- the R820T has 29 of them
# and 49.6 is the maximum. An unlisted value is a hard startup error that prints
# the actual table. Note that max gain is often NOT optimal: it amplifies noise
# equally and can drive the tuner into compression on a nearby aircraft.
SKYWARD_GAIN_DB=49.6

# --- Pipeline ----------------------------------------------------------------
# `impl_set` names a preset; the four per-stage variables override individual
# stages on top of it, same as --mag/--detect/--slice/--validate. An unknown
# name is a hard startup error listing what exists, never a silent fallback.
# `skyward list-impls` shows everything registered.
#
# SKYWARD_IMPL_SET=baseline
# SKYWARD_DETECT=correlator-v2
# SKYWARD_SLICE=integrating
# SKYWARD_MAG=naive
# SKYWARD_VALIDATE=crc-only

# --- Server ------------------------------------------------------------------
# Note that the API has no authentication of any kind: binding to 0.0.0.0 makes
# the aircraft list, the statistics and the station position readable by anyone
# on the network, and the position writable by them too unless you turn that off
# below. Fine for a home LAN; use a reverse proxy for anything else.
SKYWARD_BIND=0.0.0.0:8080
SKYWARD_DB_PATH=skyward.db

# Where a position set through the API is persisted, and whether it may be.
# SKYWARD_STATION_FILE=skyward-station.toml
# SKYWARD_STATION_WRITABLE=true

# How long recorded history is kept. 0 keeps everything and will fill the disk.
SKYWARD_RETENTION_HOURS=24

# Comma-separated CORS allowlist. Defaults to the SvelteKit dev server.
# Deliberately not a wildcard.
SKYWARD_CORS_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------------
# `text` for a terminal, `json` for journald plus machine parsing.
SKYWARD_LOG_FORMAT=text
RUST_LOG=info
