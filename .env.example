# Copy to `.env` and fill in. `.env` is gitignored -- the receiver position is
# a home address and does not belong in a public repository.
#
# Precedence, lowest to highest:  defaults  <  skyward.toml  <  .env / environment  <  CLI flags
# `skyward doctor` prints every resolved value together with where it came from,
# so a setting that did not take effect is visible rather than mysterious.

# --- Receiver position -------------------------------------------------------
# Used for local CPR resolution, the range plausibility gate, and the range ring
# the map client draws.
#
# ACCURACY: three decimal places (~100 m) is far more than enough. Local CPR only
# needs the reference to fall in the same ~670 km zone as the aircraft, and the
# range gate works at 400 km. Round these deliberately -- precision buys nothing
# here and publishing your exact address costs something. (Centimetre accuracy
# would only matter for MLAT, which this project does not do.)
#
# There is no default. The server refuses to start with the range gate enabled
# and no position, rather than silently falling back to 0,0 -- which is in the
# Gulf of Guinea and would make the gate reject every aircraft on earth.
SKYWARD_RECEIVER_LAT=45.412
SKYWARD_RECEIVER_LON=-75.679

# Antenna height above sea level, metres. Only used to estimate the theoretical
# radio horizon in `doctor`; a rough figure is fine.
SKYWARD_RECEIVER_ALT_M=90

# --- Radio -------------------------------------------------------------------
# file:PATH | tcp:HOST:PORT | usb[:INDEX]
SKYWARD_SOURCE=tcp:127.0.0.1:1234
SKYWARD_SAMPLE_RATE_HZ=2400000

# Must be one of the tuner's discrete gain values -- the R820T has 29 of them
# and 49.6 is the maximum. An unlisted value is a hard startup error that prints
# the actual table. Note that max gain is often NOT optimal: it amplifies noise
# equally and can drive the tuner into compression on a nearby aircraft.
SKYWARD_GAIN_DB=49.6

# --- Pipeline ----------------------------------------------------------------
# `impl_set` names a preset; the four per-stage variables override individual
# stages on top of it, same as --mag/--detect/--slice/--validate. An unknown
# name is a hard startup error listing what exists, never a silent fallback.
# `skyward list-impls` shows everything registered.
#
# SKYWARD_IMPL_SET=baseline
# SKYWARD_DETECT=correlator-v2
# SKYWARD_SLICE=integrating
# SKYWARD_MAG=naive
# SKYWARD_VALIDATE=crc-only

# --- Server ------------------------------------------------------------------
SKYWARD_BIND=0.0.0.0:8080
SKYWARD_DB_PATH=skyward.db

# Comma-separated CORS allowlist. Defaults to the SvelteKit dev server.
# Deliberately not a wildcard.
SKYWARD_CORS_ORIGINS=http://localhost:5173

# --- Logging -----------------------------------------------------------------
# `text` for a terminal, `json` for journald plus machine parsing.
SKYWARD_LOG_FORMAT=text
RUST_LOG=info
